enr:stmt_A01_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Kean ;
    prov:wasDerivedFrom enr:email_14290787_1075846166614 ;
    prov:wasGeneratedBy enr:act_A01 ;
    oe:literalForm "there has not been enough deregulation; the government is still very much in the way."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A03_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Kean ;
    prov:wasDerivedFrom enr:email_31087568_1075846174117 ;
    prov:wasGeneratedBy enr:act_A03 ;
    prov:wasRevisionOf enr:stmt_A02_1 ;
    oe:literalForm "the problem is fairly straightforward (demand increases and new supplies are inhibited so prices go up and shortages ensue ... sound familiar?)"@en ;
    oex:voiceMode oex:direct .

enr:stmt_A04_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:EnronPublicPolicy ;
    prov:wasDerivedFrom enr:email_716812_1075846166852 ;
    prov:wasGeneratedBy enr:act_A04 ;
    oe:literalForm "the market is working, regulation is not."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A04_2 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:EnronPublicPolicy ;
    prov:wasDerivedFrom enr:email_716812_1075846166852 ;
    prov:wasGeneratedBy enr:act_A04 ;
    oe:literalForm "The problem is regulation, not deregulation."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A05_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:SacBee ;
    prov:wasDerivedFrom enr:email_8415828_1075842977222 ;
    prov:wasGeneratedBy enr:act_A05 ;
    prov:wasQuotedFrom enr:news_A05 ;
    oe:literalForm "This is a telltale sign that California's electricity market is working for those who own power plants, not those who pay the bills that are poised to rise."@en ;
    oex:mediatedBy enr:Dasovich ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A06_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:FERC ;
    prov:wasDerivedFrom enr:email_3209089_1075856267861 ;
    prov:wasGeneratedBy enr:act_A06 ;
    prov:wasQuotedFrom enr:news_A06 ;
    oe:literalForm "California ratepayers were subjected to unjust and unreasonable power rates due to California's \"seriously flawed\" market structure and rules in conjunction with tight demand and supply conditions throughout the West."@en ;
    oex:mediatedBy enr:EEI_AllianceInfoAlert ;
    oex:voiceMode oex:reportedSpeech .

enr:stmt_A07_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Kean ;
    prov:wasDerivedFrom enr:email_13411164_1075846188375 ;
    prov:wasGeneratedBy enr:act_A07 ;
    oe:literalForm "instead of blaming generators and marketers the report blames the structure of the market for California's woes."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A08_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Denne ;
    prov:wasDerivedFrom enr:email_29378922_1075843052237 ;
    prov:wasGeneratedBy enr:act_A08 ;
    oe:literalForm "This is a publicity stunt. Three separate federal and state regulatory agencies have investigated the allegations rehashed in this lawsuit and found that no market power was exercised in California."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A09_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Kean ;
    prov:wasDerivedFrom enr:email_14658458_1075843072589 ;
    prov:wasGeneratedBy enr:act_A09 ;
    oe:literalForm "Unless we have strong evidence to the contrary, it seems to me that wholesale markets are working .... they are open and they are competitive."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A10_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:PGE ;
    prov:wasDerivedFrom enr:email_10005754_1075844135318 ;
    prov:wasGeneratedBy enr:act_A10 ;
    prov:wasQuotedFrom enr:news_A10 ;
    oe:literalForm "The California wholesale market is broken. And we are extremely disappointed by the insufficiency of today's FERC order,"@en ;
    oex:mediatedBy enr:Fawcett,
        enr:NewsOutlet_unnamed ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A12_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Walsh ;
    prov:wasDerivedFrom enr:email_17720581_1075840903917 ;
    prov:wasGeneratedBy enr:act_A12 ;
    prov:wasRevisionOf enr:stmt_A11_1 ;
    oe:literalForm "back at the poker table in Sacramento the situation continues to drift toward bankruptcy."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A13_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Abraham ;
    prov:wasDerivedFrom enr:email_29321285_1075843394361 ;
    prov:wasGeneratedBy enr:act_A13 ;
    prov:wasQuotedFrom enr:news_A13 ;
    oe:literalForm "Any action we take must either help increase supply or reduce demand. . . . Price caps will not increase supply or reduce demand."@en ;
    oex:mediatedBy enr:Dasovich,
        enr:SF_Chronicle ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A14_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Dasovich ;
    prov:wasDerivedFrom enr:email_29321285_1075843394361 ;
    prov:wasGeneratedBy enr:act_A14 ;
    oe:literalForm "Note Abraham's quote in p.#3 re: \"must increase supply or decrease demand.\" I've heard that somewhere before."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A15_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Davis ;
    prov:wasDerivedFrom enr:email_8069579_1075843400180 ;
    prov:wasGeneratedBy enr:act_A15 ;
    prov:wasQuotedFrom enr:news_A15 ;
    oe:literalForm "It's wrong and irresponsible of the utilities to pocket this money and not pay the generators,"@en ;
    oex:mediatedBy enr:AssociatedPress,
        enr:Dasovich ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A16_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Dasovich ;
    prov:wasDerivedFrom enr:email_3901232_1075843403288 ;
    prov:wasGeneratedBy enr:act_A16 ;
    oe:literalForm "This is yet another, tangible case of why price caps don't and can't help; they can and will only make matters worse."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A17_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Dasovich ;
    prov:wasDerivedFrom enr:email_28714256_1075843416912 ;
    prov:wasGeneratedBy enr:act_A17 ;
    oe:literalForm "The other thing that Governor and his PUC could have done many months ago was realign rates to more accurately reflect the real cost of power. That arguably was a key determinant driving PG&E to Bankruptcy."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A18_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Tribolet ;
    prov:wasDerivedFrom enr:email_22433150_1075847600814 ;
    prov:wasGeneratedBy enr:act_A18 ;
    oe:literalForm "The primary short-term issue facing us is whether we wish to throw our name in to be co-chair."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A19_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Tribolet ;
    prov:wasDerivedFrom enr:email_22014418_1075853221515 ;
    prov:wasGeneratedBy enr:act_A19 ;
    oe:literalForm "PG&E want to fight the TURN accounting as it, basically, wiped out hopes of collecting their undercollected amount from a regulatory accounting perspective."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A20_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Shapiro ;
    prov:wasDerivedFrom enr:email_7997110_1075843348616 ;
    prov:wasGeneratedBy enr:act_A20 ;
    oe:literalForm "We need to force FERC's hand with a well-thought out pleading on why they have to enforce order on independent governance and why a politicized CAL ISO is a recipe for disaster."@en ;
    oex:voiceMode oex:direct .

enr:stmt_A21_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Walsh ;
    prov:wasDerivedFrom enr:email_30089639_1075843518185 ;
    prov:wasGeneratedBy enr:act_A21 ;
    oe:literalForm "Corroborating our line over the past four months, Anglelides stated with confidence that SoCal would go bankrupt"@en ;
    oex:voiceMode oex:direct .

enr:stmt_A22_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Angelides ;
    prov:wasDerivedFrom enr:email_30089639_1075843518185 ;
    prov:wasGeneratedBy enr:act_A22 ;
    prov:wasQuotedFrom enr:news_A22 ;
    oe:literalForm "he was surprised they hadn't already."@en ;
    oex:mediatedBy enr:Walsh,
        enr:Walsh_source_unnamed ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A23_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Baum ;
    prov:wasDerivedFrom enr:email_19364023_1075846165444 ;
    prov:wasGeneratedBy enr:act_A23 ;
    prov:wasQuotedFrom enr:news_A23 ;
    oe:literalForm "electric market is broken"@en ;
    oex:mediatedBy enr:DSGeorge_ALSTOM,
        enr:WallStreetJournal ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A24_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Shames ;
    prov:wasDerivedFrom enr:email_22945919_1075842959237 ;
    prov:wasGeneratedBy enr:act_A24 ;
    prov:wasQuotedFrom enr:news_A24 ;
    oe:literalForm "the almost irreparably broken California energy system."@en ;
    oex:mediatedBy enr:Dasovich,
        enr:SanDiegoUnionTribune ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A24_2 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Shames ;
    prov:wasDerivedFrom enr:email_22945919_1075842959237 ;
    prov:wasGeneratedBy enr:act_A24 ;
    prov:wasQuotedFrom enr:news_A24 ;
    oe:literalForm "It's a market controlled by the sellers of power and their cronies."@en ;
    oex:mediatedBy enr:Dasovich,
        enr:SanDiegoUnionTribune ;
    oex:voiceMode oex:quotedSpeech .

enr:stmt_A25_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Skilling ;
    prov:wasDerivedFrom enr:email_18570867_1075849283952 ;
    prov:wasGeneratedBy enr:act_A25 ;
    prov:wasQuotedFrom enr:news_A25 ;
    oe:literalForm "The state Public Utilities Commission in the early 1990s put together a broken market by preventing utilities to pass along the full cost of power and discouraging power contracts that would have lowered dependence on buying last-minute power"@en ;
    oex:mediatedBy enr:AssociatedPress,
        enr:Buster ;
    oex:voiceMode oex:reportedSpeech .

enr:stmt_A26_1 a oe:InterpretationStatement ;
    prov:wasAttributedTo enr:Dasovich ;
    prov:wasDerivedFrom enr:email_27911004_1075843541830 ;
    prov:wasGeneratedBy enr:act_A26 ;
    oe:literalForm "Stop the blame; stop the political rhetoric. If there's evidence that manipulation has occured, produce it--the investigations have been going on for a year."@en ;
    oex:voiceMode oex:direct .

